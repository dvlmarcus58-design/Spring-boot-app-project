pipeline {

    agent any

    environment {
        SONAR_URL = "http://13.127.224.135:9000"

        GIT_REPO_NAME = "Spring-boot-app-project-main"
        GIT_USER_NAME = "dvlmarcus58-design"
        GIT_USER_EMAIL = "dvlmarcus58@gmail.com"

        DOCKER_REGISTRY_URL = "https://index.docker.io/v1/"
        DOCKER_IMAGE_NAME = "dvlmarcus58/ultimate-cicd-3"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Debug Workspace') {
            steps {
                sh '''
                    echo "======================================"
                    echo "         WORKSPACE INFORMATION"
                    echo "======================================"

                    echo "Current directory:"
                    pwd

                    echo ""
                    echo "Java version:"
                    java -version

                    echo ""
                    echo "Maven version:"
                    mvn -version

                    echo ""
                    echo "Docker version:"
                    docker --version

                    echo ""
                    echo "Workspace files:"
                    ls -la

                    echo ""
                    echo "Directory structure:"
                    find . -maxdepth 3 -type f | sort | head -100

                    echo ""
                    echo "Git status:"
                    git status || true
                '''
            }
        }

        stage('Check Required Tools') {
            steps {
                sh '''
                    echo "Checking required tools..."

                    command -v java
                    command -v mvn
                    command -v docker
                    command -v git

                    echo "All required tools are available."
                '''
            }
        }

        stage('Build and Test') {
            steps {
                dir('Spring-boot-app-project-main/spring-boot-app') {
                    sh '''
                        echo "======================================"
                        echo "       BUILDING JAVA APPLICATION"
                        echo "======================================"

                        mvn clean package

                        echo ""
                        echo "Build completed successfully."
                    '''
                }
            }
        }

        stage('Static Code Analysis') {
            steps {

                dir('Spring-boot-app-project-main/spring-boot-app') {

                    withCredentials([
                        string(
                            credentialsId: 'sonarqube',
                            variable: 'SONAR_AUTH_TOKEN'
                        )
                    ]) {

                        sh '''
                            echo "======================================"
                            echo "        SONARQUBE ANALYSIS"
                            echo "======================================"

                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:4.0.0.4121:sonar \
                                -Dsonar.login="$SONAR_AUTH_TOKEN" \
                                -Dsonar.host.url="$SONAR_URL"
                        '''
                    }
                }
            }
        }

        stage('Build Docker Image') {

            environment {
                DOCKER_IMAGE = "${DOCKER_IMAGE_NAME}:${BUILD_NUMBER}"
            }

            steps {

                dir('Spring-boot-app-project-main/spring-boot-app') {

                    sh '''
                        echo "======================================"
                        echo "        BUILDING DOCKER IMAGE"
                        echo "======================================"

                        echo "Docker image:"
                        echo "$DOCKER_IMAGE"

                        docker build \
                            -t "$DOCKER_IMAGE" .

                        echo ""
                        echo "Docker image created successfully."

                        docker images | grep "ultimate-cicd-3" || true
                    '''
                }
            }
        }

        stage('Push Docker Image') {

            environment {
                DOCKER_IMAGE = "${DOCKER_IMAGE_NAME}:${BUILD_NUMBER}"
            }

            steps {

                withDockerRegistry([
                    credentialsId: 'docker-cred',
                    url: "${DOCKER_REGISTRY_URL}"
                ]) {

                    sh '''
                        echo "======================================"
                        echo "        PUSHING DOCKER IMAGE"
                        echo "======================================"

                        echo "Pushing:"
                        echo "$DOCKER_IMAGE"

                        docker push "$DOCKER_IMAGE"

                        echo ""
                        echo "Docker image pushed successfully."
                    '''
                }
            }
        }

        stage('Update Kubernetes Manifest') {

            steps {

                sh '''
                    echo "======================================"
                    echo "      UPDATING KUBERNETES MANIFEST"
                    echo "======================================"

                    echo "Replacing image tag with:"
                    echo "$BUILD_NUMBER"

                    sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" \
                    Spring-boot-app-project-main/spring-boot-app-manifests/deployment.yml

                    echo ""
                    echo "Updated deployment.yml:"
                    cat Spring-boot-app-project-main/spring-boot-app-manifests/deployment.yml
                '''
            }
        }

        stage('Commit and Push Manifest') {

            steps {

                withCredentials([
                    string(
                        credentialsId: 'github',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {

                    sh '''
                        echo "======================================"
                        echo "       PUSHING MANIFEST TO GITHUB"
                        echo "======================================"

                        git config user.name "$GIT_USER_NAME"
                        git config user.email "$GIT_USER_EMAIL"

                        git add \
                        Spring-boot-app-project-main/spring-boot-app-manifests/deployment.yml

                        git commit \
                        -m "Update deployment image to version ${BUILD_NUMBER}" || true

                        git push \
                        https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git \
                        HEAD:main

                        echo ""
                        echo "Manifest pushed successfully."
                    '''
                }
            }
        }
    }

    post {

        always {
            echo '======================================'
            echo '          PIPELINE FINISHED'
            echo '======================================'
        }

        success {
            echo '======================================'
            echo '          BUILD SUCCEEDED'
            echo '======================================'
        }

        failure {
            echo '======================================'
            echo '            BUILD FAILED'
            echo '======================================'
        }
    }
}
