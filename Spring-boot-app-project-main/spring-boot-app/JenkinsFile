pipeline {
    agent {
        docker {
            image 'maven:3.9.4-eclipse-temurin-17'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    environment {
        SONAR_URL = "http://43.205.152.250:9000"

        GIT_REPO_NAME = "Spring-boot-app-project-main"
        GIT_USER_NAME = "dvlmarcus58-design"
        GIT_USER_EMAIL = "dvlmarcus58@gmail.com"

        DOCKER_REGISTRY_URL = "https://index.docker.io/v1/"
        DOCKER_IMAGE_NAME = "dvlmarcus58/ultimate-cicd-2"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Debug Workspace') {
            steps {
                sh '''
                    echo "===== CURRENT DIRECTORY ====="
                    pwd

                    echo "===== FILES ====="
                    ls -la

                    echo "===== GIT DIRECTORY ====="
                    find . -name .git

                    echo "===== GIT STATUS ====="
                    git status || true
                '''
            }
        }

        stage('Build and Test') {
            steps {
                sh '''
                    cd Spring-boot-app-project-main/spring-boot-app
                    mvn clean package
                '''
            }
        }

        stage('Static Code Analysis') {
            steps {
                withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
                    sh '''
                        cd Spring-boot-app-project-main/spring-boot-app

                        mvn org.sonarsource.scanner.maven:sonar-maven-plugin:4.0.0.4121:sonar \
                            -Dsonar.login=$SONAR_AUTH_TOKEN \
                            -Dsonar.host.url=${SONAR_URL}
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            environment {
                DOCKER_IMAGE = "${DOCKER_IMAGE_NAME}:${BUILD_NUMBER}"
            }

            steps {
                sh '''
                    apt-get update
                    apt-get install -y docker.io

                    docker --version
                '''

                sh """
                    cd Spring-boot-app-project-main/spring-boot-app
                    docker build -t ${DOCKER_IMAGE} .
                """
            }
        }

        stage('Push Docker Image') {
            environment {
                DOCKER_IMAGE = "${DOCKER_IMAGE_NAME}:${BUILD_NUMBER}"
            }

            steps {
                withDockerRegistry([credentialsId: 'docker-cred',
                                    url: "${DOCKER_REGISTRY_URL}"]) {

                    sh "docker push ${DOCKER_IMAGE}"
                }
            }
        }

        stage('Update Manifest and Push') {
            steps {

                withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {

                    sh """
                        git config --global user.name "${GIT_USER_NAME}"
                        git config --global user.email "${GIT_USER_EMAIL}"
                    """

                    sh """
                        sed -i 's/replaceImageTag/${BUILD_NUMBER}/g' \
                        Spring-boot-app-project-main/spring-boot-app-manifests/deployment.yml
                    """

                    sh """
                        git add Spring-boot-app-project-main/spring-boot-app-manifests/deployment.yml

                        git commit -m "Update deployment image to version ${BUILD_NUMBER}" || true

                        git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:main
                    """
                }
            }
        }
    }

    post {
        always {
            echo 'Pipeline finished'
        }

        success {
            echo 'Build succeeded!'
        }

        failure {
            echo 'Build failed!'
        }
    }
}
